@article{mendelsohn,
  title = {The {{Impact}} of {{Global Warming}} on {{Agriculture}}: {{A Ricardian Analysis}}},
  shorttitle = {The {{Impact}} of {{Global Warming}} on {{Agriculture}}},
  author = {Mendelsohn, Robert O. and Nordhaus, William D. and Shaw, Daigee},
  year = 1994,
  journal = {The American Economic Review},
  volume = {84},
  number = {4},
  eprint = {2118029},
  eprinttype = {jstor},
  pages = {753--771},
  publisher = {American Economic Association},
  issn = {0002-8282},
  urldate = {2022-04-05},
  abstract = {We measure the economic impact of climate on land prices. Using cross-sectional data on climate, farmland prices, and other economic and geophysical data for almost 3,000 counties in the United States, we find that higher temperatures in all seasons except autumn reduce average farm values, while more precipitation outside of autumn increases farm values. Applying the model to a global-warming scenario shows a significantly lower estimated impact of global warming on U.S. agriculture than the traditional production-function approach and, in one case, suggests that, even without CO\textsubscript{2} fertilization, global warming may have economic benefits for agriculture.}
}

@article{ortiz-bobea,
  title = {Anthropogenic Climate Change Has Slowed Global Agricultural Productivity Growth},
  author = {{Ortiz-Bobea}, Ariel and Ault, Toby R. and Carrillo, Carlos M. and Chambers, Robert G. and Lobell, David B.},
  year = 2021,
  month = apr,
  journal = {Nature Climate Change},
  volume = {11},
  number = {4},
  pages = {306--312},
  publisher = {Nature Publishing Group},
  issn = {1758-6798},
  doi = {10.1038/s41558-021-01000-1},
  urldate = {2022-02-22},
  abstract = {Agricultural research has fostered productivity growth, but the historical influence of anthropogenic climate change (ACC) on that growth has not been quantified. We develop a robust econometric model of weather effects on global agricultural total factor productivity (TFP) and combine this model with counterfactual climate scenarios to evaluate impacts of past climate trends on TFP. Our baseline model indicates that ACC has reduced global agricultural TFP by about 21\% since 1961, a slowdown that is equivalent to losing the last 7 years of productivity growth. The effect is substantially more severe (a reduction of \textasciitilde 26--34\%) in warmer regions such as Africa and Latin America and the Caribbean. We also find that global agriculture has grown more vulnerable to ongoing climate change.},
  copyright = {2021 The Author(s), under exclusive licence to Springer Nature Limited part of Springer Nature},
  langid = {english},
  keywords = {Agriculture,Climate-change impacts,Sustainability},
  file = {C:\Users\loihenry\Zotero\storage\PF6K2WYW\s41558-021-01000-1.html}
}

